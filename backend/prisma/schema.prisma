generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Perfume {
  id              String   @id @default(cuid())
  name            String
  brand           String
  price           Float
  olfactoryFamily String
  topNotes        String
  heartNotes      String
  baseNotes       String
  intensity       String
  imageUrl        String?
  model3dUrl      String?
  stock           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}